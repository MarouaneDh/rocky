# Inbox that receives contact and sign-up form submissions.
CONTACT_TO=

# SMTP account that sends them. Defaults to Gmail (smtp.gmail.com:465); use a Gmail app password.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional alternative: forward submissions as JSON to a webhook (Zapier, Make, Formspree) instead.
# FORMS_WEBHOOK_URL=

# MailerLite: sign-ups are added to these groups. Without a key they are emailed/forwarded like the contact form.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_NEWSLETTER=
MAILERLITE_GROUP_PODCAST=
